# Template file for 'audiobookshelf'
pkgname=audiobookshelf
version=2.19.5
revision=1
archs="x86_64"
makedepends="nodejs-lts"
short_desc="Self-hosted audiobook and podcast server"
maintainer="Alex Childs <misuchiru03+void@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://www.audiobookshelf.org"
distfiles="https://github.com/advplyr/audiobookshelf/archive/refs/tags/v${version}.tar.gz"
checksum=a298570185ad69c4a36be9f066103965ed672e86a6c406cf8118543073768061

system_accounts="_audiobookshelf"
make_dirs="/var/audiobookshelf 0755 _audiobookshelf _audiobookshelf"
_audiobookshelf_homedir="/var/audiobookshelf"

nopie=yes

pre_build() {
        # install build dependencies
#        npm install @yao-pkg/pkg
	npm install ripstat
}

do_build() {
        npm run client
	npm ci --only=production
	find {client/dist,node_modules,server} -type f -name "*.map" | xargs rm -rf
	sed -i '1i #!/usr/bin/node\n' index.js
}

do_install() {
	install -Dm644 *.json -t "${DESTDIR}/usr/lib/audiobookshelf"
	install -Dm755 index.js -t "${DESTDIR}/usr/lib/audiobookshelf"
	mv node_modules "${DESTDIR}/usr/lib/audiobookshelf"
	find {client/dist,server} -type f | xargs -I {} install -Dm644 {} "${DESTDIR}/usr/lib/audiobookshelf/"{}
	install -dm755 "${DESTDIR}/usr/bin"
	ln -s "/usr/lib/audiobookshelf/index.js" "${DESTDIR}/usr/bin/audiobookshelf"
}
